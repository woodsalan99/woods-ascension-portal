// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Authoritative source: MASTER_BUILD_SPEC.md §5. Do not modify without
// following the Change Protocol in §12 (flag to Alan, log an ADR in §2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum StageKey {
  STAGE_1
  STAGE_2
  STAGE_3
  STAGE_4
}

enum StepState {
  DONE
  CURRENT
  ACTIVE
  NEXT
}

enum MilestoneState {
  DONE
  CURRENT
  NEXT
}

enum CallType {
  DISCOVERY
  SALES
}

// What kind of business a client is — drives which nav/pages/sync jobs
// apply. COLD_EMAIL clients are untouched by everything LOCAL_SERVICES
// adds (see IMPLEMENTATION_STATE.md D-A through D-F).
enum ClientType {
  COLD_EMAIL
  LOCAL_SERVICES
}

// Where a LOCAL_SERVICES lead came from.
enum LeadSource {
  LSA
  GBP_CALL
  WEBSITE_FORM
  REFERRAL
  OTHER
}

// The 8-column kanban stages for a LOCAL_SERVICES lead (Canencia handoff §2/§4.3).
enum LeadStage {
  NEW
  CONTACTED
  QUOTE_SENT
  JOB_SCHEDULED
  JOB_WON
  REVIEW_REQUESTED
  REVIEW_COMPLETE
  LOST
}

// How a metric's target scales with the selected time window.
// WEEKLY/DAILY targets are multiplied by the number of weeks/days in the
// window; PERPETUAL targets (rates, efficiency ratios) stay constant.
enum MetricCadence {
  DAILY
  WEEKLY
  PERPETUAL
}

model Client {
  id             String               @id @default(cuid())
  name           String
  slug           String               @unique
  timezone       String // IANA, e.g. "America/Los_Angeles"
  status         String               @default("ACTIVE") // ACTIVE | PAUSED | ARCHIVED
  type           ClientType           @default(COLD_EMAIL) // drives nav/pages/sync gating — see IMPLEMENTATION_STATE.md D-A..D-F
  stageLabels    Json // { STAGE_1: "Positive Reply", STAGE_2: "Appointment Booked", ... }
  calendarLink   String?
  intakeFormLink String?
  onboardingDate DateTime? // Day 1 of the "Day N" counter on Overview — distinct from launchDate
  launchDate     DateTime? // typically onboardingDate + ~22 days ("Day 23"), but independently editable
  heroName       String? // display name in portal header
  domainsLive    Int? // pre-launch KPI row (§8) — admin-editable, null hides the KPI
  inboxesWarming Int?
  warmupSends    Int?
  welcomeTitle   String? // admin-authored banner shown at the top of Overview (onboarding welcome)
  welcomeMessage String?
  createdAt      DateTime             @default(now())
  users          User[]
  campaigns      Campaign[]
  dailyStats     DailyStat[]
  pipeline       PipelineEntry[]
  milestones     Milestone[]
  onboarding     OnboardingStep[]
  notes          WeeklyNote[]
  audiences      Audience[]
  infrastructure InfrastructureItem[]
  metricConfigs  MetricConfig[]
  changelog      ChangelogEntry[]
  documents      Document[]
  domains        Domain[]
  internalNotes  InternalNote[]

  // LOCAL_SERVICES — see IMPLEMENTATION_STATE.md §2 Migration B
  integrations         ClientIntegration[]
  serviceLeads         ServiceLead[]
  callRecords          CallRecord[]
  formSubmissions      FormSubmission[]
  lsaMonthlyStats      LsaMonthlyStat[]
  gscDailyStats        GscDailyStat[]
  sitePages            SitePage[]
  locations            ClientLocation[]
  geogridScans         GeogridScan[]
  keywordRanks         KeywordRank[]
  reviewSnapshots      ReviewSnapshot[]
  reviewItems          ReviewItem[]
  reviewRequests       ReviewRequest[]
  tasks                ClientTask[]
  workLogs             WorkLog[]
  monthlyWork          MonthlyWork[]
  content              PortalContent[]
  metricOverrides      MetricOverride[]
  notificationChannels NotificationChannel[]
  notifications        Notification[]
}

// Admin-only internal notes log per client — never shown to the client.
// A dated scratchpad to keep everything about a client in one place.
model InternalNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  date      DateTime
  title     String?
  body      String
  createdAt DateTime @default(now())
}

// Deliverability tracking for sending domains (admin-only). Health metrics
// (reply/bounce) come live from Smartlead; this table holds the bits
// Smartlead doesn't: which client a domain belongs to (Smartlead doesn't
// tag it), the cold-send start date, a burned mark, and notes.
model Domain {
  id            String    @id @default(cuid())
  domain        String    @unique
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id])
  coldStartDate DateTime? // first real (non-warmup) send — for lifespan tracking
  burnedAt      DateTime? // manually marked burned/retired
  note          String?
  createdAt     DateTime  @default(now())
}

// Client-visible official documents (invoices, contracts, etc). File bytes
// stored inline — these are small (PDFs/images), and Railway has no blob
// store configured. Served via /api/documents/[id] with a scope check.
model Document {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  name        String // display title
  fileName    String // original filename
  contentType String // MIME type
  data        Bytes // file contents
  note        String? // shown to the client when they open the doc
  docDate     DateTime // the date on the document (invoice date, signing date, ...)
  createdAt   DateTime @default(now())
}

model Audience {
  id         String              @id @default(cuid())
  clientId   String
  client     Client              @relation(fields: [clientId], references: [id])
  name       String // e.g. "Limos", "Towing"
  sortOrder  Int
  campaigns  Campaign[]
  pipeline   PipelineEntry[]
  dailyStats AudienceDailyStat[]
}

model User {
  id       String  @id @default(cuid())
  clerkId  String  @unique
  email    String  @unique
  role     Role
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])
}

model Campaign {
  id                  String    @id @default(cuid())
  clientId            String
  client              Client    @relation(fields: [clientId], references: [id])
  smartleadCampaignId String    @unique
  name                String
  active              Boolean   @default(true)
  audienceId          String?
  audience            Audience? @relation(fields: [audienceId], references: [id])
}

model DailyStat {
  id                  String   @id @default(cuid())
  clientId            String
  client              Client   @relation(fields: [clientId], references: [id])
  date                DateTime // date-only, client-TZ bucket, stored as UTC midnight
  sends               Int      @default(0) // bucketed by SEND date
  totalReplies        Int      @default(0) // bucketed by REPLY date
  positiveReplies     Int      @default(0) // bucketed by REPLY date
  bounces             Int      @default(0) // bucketed by SEND date
  apptsBooked         Int      @default(0) // manual, derived from PipelineEntry counts by admin action or nightly rollup
  positiveReplyEmails Json? // string[] of emails counted positive on this reply-day (debug/audit)

  @@unique([clientId, date])
}

// Parallel to DailyStat, broken down by Audience instead of aggregated
// across the whole client — see D19-era Audience concept (v1.1).
// Campaigns without an audienceId don't contribute here (still counted
// in client-level DailyStat as before).
model AudienceDailyStat {
  id                  String   @id @default(cuid())
  audienceId          String
  audience            Audience @relation(fields: [audienceId], references: [id])
  date                DateTime
  sends               Int      @default(0) // bucketed by SEND date
  totalReplies        Int      @default(0) // bucketed by REPLY date
  positiveReplies     Int      @default(0) // bucketed by REPLY date
  bounces             Int      @default(0) // bucketed by SEND date
  apptsBooked         Int      @default(0)
  positiveReplyEmails Json? // string[] of emails counted positive on this reply-day (debug/audit)

  @@unique([audienceId, date])
}

model PipelineEntry {
  id                 String         @id @default(cuid())
  clientId           String
  client             Client         @relation(fields: [clientId], references: [id])
  audienceId         String?
  audience           Audience?      @relation(fields: [audienceId], references: [id])
  stage              StageKey
  contactName        String
  email              String? // dedup key for auto-added positive replies (v1.1)
  company            String
  dealValue          Int? // whole dollars; null allowed
  notes              String?
  // Journey dates. positiveReplyDate is auto-populated by the sync from the
  // Smartlead reply. Discovery/sales calls now live in PipelineCall (a lead
  // can have several); discoveryCallDate/salesCallDate remain for backfill
  // but callDateTime is kept in sync with the primary (next) discovery call
  // so the client Appointments page keeps working.
  positiveReplyDate  DateTime?
  discoveryCallDate  DateTime? // legacy single date (superseded by calls[])
  salesCallDate      DateTime? // legacy single date (superseded by calls[])
  closeDate          DateTime?
  callDateTime       DateTime? // primary appointment date = next-upcoming discovery call
  callStatus         String? // CONFIRMED | PENDING | HELD | NO_SHOW
  qualified          Boolean        @default(true)
  disqualifiedReason String?
  nextActionStep     String? // admin note: what to do next for this booked lead
  calls              PipelineCall[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model PipelineCall {
  id              String        @id @default(cuid())
  pipelineEntryId String
  entry           PipelineEntry @relation(fields: [pipelineEntryId], references: [id], onDelete: Cascade)
  type            CallType
  date            DateTime
  note            String?
  createdAt       DateTime      @default(now())
}

model Milestone {
  id           String         @id @default(cuid())
  clientId     String
  client       Client         @relation(fields: [clientId], references: [id])
  label        String
  subLabel     String? // e.g. "Day 21" or "3 of 5"
  state        MilestoneState
  targetValue  Int?
  currentValue Int?
  sortOrder    Int
}

model OnboardingStep {
  id               String    @id @default(cuid())
  clientId         String
  client           Client    @relation(fields: [clientId], references: [id])
  label            String
  description      String? // shown when the client expands the step
  dayLabel         String // "Day 0", "Days 1–3"
  state            StepState
  ctaLabel         String?
  ctaUrl           String?
  sortOrder        Int
  clientActionable Boolean   @default(false) // if true and state=CURRENT, CLIENT can mark it DONE (v1.1, D21)
}

// Reusable defaults an admin can apply to a new client in one click instead
// of hand-authoring roadmap/metrics/milestones every time. A template's own
// rows are never client-visible — "applying" copies them into that client's
// real OnboardingStep/MetricConfig/Milestone rows.
model Template {
  id         String                   @id @default(cuid())
  name       String
  createdAt  DateTime                 @default(now())
  steps      TemplateOnboardingStep[]
  metrics    TemplateMetricConfig[]
  milestones TemplateMilestone[]
}

model TemplateOnboardingStep {
  id               String   @id @default(cuid())
  templateId       String
  template         Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label            String
  description      String?
  dayLabel         String
  ctaLabel         String?
  ctaUrl           String?
  clientActionable Boolean  @default(false)
  sortOrder        Int
}

model TemplateMetricConfig {
  id         String        @id @default(cuid())
  templateId String
  template   Template      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  metricKey  String
  cadence    MetricCadence @default(PERPETUAL)
  targetMin  Float?
  targetMax  Float?
  tips       Json
  sortOrder  Int

  @@unique([templateId, metricKey])
}

model TemplateMilestone {
  id          String   @id @default(cuid())
  templateId  String
  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label       String
  subLabel    String?
  targetValue Int?
  sortOrder   Int
}

model InfrastructureItem {
  id          String  @id @default(cuid())
  clientId    String
  client      Client  @relation(fields: [clientId], references: [id])
  label       String
  quantity    Int
  status      String // ACTIVE | LOADED | COMPLETE | PENDING
  monthlyCost Int // whole dollars
  notes       String?
  sortOrder   Int
}

// Actual metric VALUES are always computed live from DailyStat/PipelineEntry.
// This only stores the admin-authored "coaching" layer on top — see D20/v1.1.
// status is NOT stored — it's computed per selected time period by comparing
// the live value against targetMin/targetMax (only-min = "at least", only-max
// = "at most", both = range, neither set = always ON_TRACK). See D22.
model MetricConfig {
  id        String        @id @default(cuid())
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id])
  metricKey String
  cadence   MetricCadence @default(PERPETUAL) // how the target scales with the time window
  targetMin Float? // "healthy" lower bound, at the cadence's base unit (per week for WEEKLY, etc.)
  targetMax Float? // "healthy" upper bound, at the cadence's base unit
  tips      Json // string[]
  sortOrder Int

  @@unique([clientId, metricKey])
}

// v1.1: internal tracking log, client-visible but framed as "mostly ignore
// this" — when Woods Ascension launched/bought/changed something for this
// client. Admin-authored, read-only for the client.
model ChangelogEntry {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  date      DateTime
  title     String
  body      String?
  createdAt DateTime @default(now())
}

model WeeklyNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  weekOf    DateTime
  headline  String
  body      String
  videoUrl  String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SyncRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String // SUCCESS | FAILED
  detail     String? // error text or counts summary
  source     String    @default("SMARTLEAD") // SMARTLEAD | CALLRAIL | GMAIL | GSC | PLACES — each cron route's
  // self-heal and own-row queries are scoped to its own source, so a fast-cycling
  // route (e.g. Gmail every 5 min) can never mark a slower route's still-running
  // sync as FAILED. See IMPLEMENTATION_STATE.md D-E.
}

// ============================================================
// LOCAL_SERVICES — see IMPLEMENTATION_STATE.md §2 Migration B.
// Every model below is scoped to Client.type == LOCAL_SERVICES.
// Nothing here is read by any COLD_EMAIL code path.
// ============================================================

// One row per connected external account for a client (CallRail, Gmail,
// Google Search Console, Google Places). Credentials are sealed with
// AES-256-GCM using the ENCRYPTION_KEY env var — never stored in plaintext.
// No self-serve OAuth UI: Alan completes the one-time consent per client.
model ClientIntegration {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  provider    String // CALLRAIL | GMAIL | GSC | GOOGLE_PLACES
  config      Json // per-provider matcher/config (form from-address, GSC property, place_id, cursor, ...)
  credentials Bytes // AES-256-GCM sealed refresh token / API key (Uint8Array on read — Prisma 6)
  status      String    @default("ACTIVE") // ACTIVE | ERROR | DISABLED
  lastSyncAt  DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())

  @@unique([clientId, provider])
}

// A local-services lead, wherever it came from (LSA email, Google Maps
// call, website form, referral). The 8-column kanban entity.
model ServiceLead {
  id               String          @id @default(cuid())
  clientId         String
  client           Client          @relation(fields: [clientId], references: [id])
  source           LeadSource
  stage            LeadStage       @default(NEW)
  name             String? // null = LSA's "Potential Customer" (name hidden by Google)
  phone            String?
  email            String?
  location         String? // city
  address          String? // full project address (form leads only)
  serviceType      String?
  message          String?
  qualified        Boolean? // null = unreviewed
  needsDetails     Boolean         @default(false) // LSA: name/phone hidden until Alan replies in Google
  jobValue         Int? // whole dollars; set ONLY when dropped into JOB_WON — never asked anywhere else
  callRecordId     String?         @unique
  callRecord       CallRecord?     @relation(fields: [callRecordId], references: [id], onDelete: SetNull)
  formSubmissionId String?         @unique
  formSubmission   FormSubmission? @relation(fields: [formSubmissionId], references: [id], onDelete: SetNull)
  gmailMessageId   String?         @unique // idempotency for LSA-sourced leads (no FormSubmission row to dedupe through)
  callRailUrl      String?
  recordingUrl     String?
  nextActionLabel  String?
  nextActionAt     DateTime?
  receivedAt       DateTime
  stageChangedAt   DateTime        @default(now())
  createdAt        DateTime        @default(now())
  notes            LeadNote[]
  activity         LeadActivity[]
  reviewRequests   ReviewRequest[]

  @@index([clientId, stage])
  @@index([clientId, receivedAt])
}

model LeadNote {
  id           String      @id @default(cuid())
  leadId       String
  lead         ServiceLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorUserId String
  body         String
  createdAt    DateTime    @default(now())
}

// Powers "followed up this week" and the drag/stage-move history.
model LeadActivity {
  id        String      @id @default(cuid())
  leadId    String
  lead      ServiceLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String // STAGE_MOVE | NOTE | QUALIFIED_TOGGLE | VALUE_SET | TOUCH
  meta      Json?
  createdAt DateTime    @default(now())

  @@index([leadId, createdAt])
}

// One row per CallRail call. Classification rules are handoff §3.1 verbatim:
// keypress present -> QUALIFIED; no keypress on the IVR line -> ROBOCALL;
// the LSA line bypasses the IVR entirely -> QUALIFIED; under 20s is flagged
// for review (needsReview), never auto-deleted.
model CallRecord {
  id             String       @id @default(cuid())
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  callRailId     String       @unique
  occurredAt     DateTime
  durationSec    Int
  callerNumber   String
  trackingNumber String
  keypress       String?
  classification String // QUALIFIED | ROBOCALL | SPAM | WRONG_AREA | UNKNOWN
  needsReview    Boolean      @default(false)
  forwarded      Boolean
  recordingUrl   String?
  raw            Json
  lead           ServiceLead?

  @@index([clientId, occurredAt])
}

// One row per parsed website estimate-request email (Gmail ingestion,
// handoff §3.2B). Spam is always logged here, even when never shown to
// the client ("junk blocked" counts on Overview come from this table).
model FormSubmission {
  id             String       @id @default(cuid())
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  gmailMessageId String       @unique
  receivedAt     DateTime
  name           String?
  phone          String?
  email          String?
  address        String?
  message        String?
  spamVerdict    Boolean? // null = low-confidence classification, awaiting Alan's manual review
  spamConfidence Float?
  spamReason     String?
  passedOn       Boolean      @default(false)
  raw            Json // parsed body + parse error detail, if any — never lose the source email
  lead           ServiceLead?

  @@index([clientId, receivedAt])
}

// Manual monthly entry (no public LSA API) — Google Local Services Ads
// performance. month is a client-timezone "YYYY-MM" string.
model LsaMonthlyStat {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  month         String
  impressions   Int
  topRatePct    Float
  absTopRatePct Float
  spendCents    Int
  chargedLeads  Int
  updatedAt     DateTime @updatedAt

  @@unique([clientId, month])
}

// Google Search Console daily clicks/impressions (date-only, UTC midnight —
// same convention as DailyStat).
model GscDailyStat {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  date        DateTime
  clicks      Int
  impressions Int

  @@unique([clientId, date])
}

// A town/service page on the client's site — tracked for whether Google
// has indexed it yet. Added manually by Alan when a page ships.
model SitePage {
  id            String    @id @default(cuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id])
  url           String
  town          String
  publishedAt   DateTime
  indexed       Boolean   @default(false)
  indexedAt     DateTime?
  lastCheckedAt DateTime?

  @@unique([clientId, url])
}

// A physical business location for clients with more than one Google
// Business Profile (multi-GBP from day one for some clients).
model ClientLocation {
  id           String        @id @default(cuid())
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id])
  name         String
  isPrimary    Boolean       @default(false)
  geogridScans GeogridScan[]
}

// One monthly Local Falcon geogrid export for one keyword at one location.
// gridJson is normalized to { rows, cols, cells: number[] } at upload so
// the renderer can draw any grid size, not just the mock's 7x7.
model GeogridScan {
  id         String         @id @default(cuid())
  clientId   String
  client     Client         @relation(fields: [clientId], references: [id])
  locationId String
  location   ClientLocation @relation(fields: [locationId], references: [id])
  keyword    String
  month      String
  gridJson   Json
  avgRank    Float // computed server-side on upload
  top3Pct    Float
  takenAt    DateTime

  @@unique([clientId, locationId, keyword, month])
}

// Monthly Ahrefs CSV import — organic keyword rankings.
model KeywordRank {
  id           String @id @default(cuid())
  clientId     String
  client       Client @relation(fields: [clientId], references: [id])
  month        String
  keyword      String
  volume       Int?
  position     Int
  prevPosition Int?
  url          String

  @@unique([clientId, month, keyword])
}

// Daily Google Places review count/rating snapshot.
model ReviewSnapshot {
  id       String   @id @default(cuid())
  clientId String
  client   Client   @relation(fields: [clientId], references: [id])
  date     DateTime
  count    Int
  rating   Float

  @@unique([clientId, date])
}

// The five most recent reviews, refreshed daily from Google Places.
// Places gives no stable per-review id, so dedup on (author, reviewedAt).
model ReviewItem {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  author     String
  rating     Int
  text       String
  reviewedAt DateTime

  @@unique([clientId, author, reviewedAt])
}

// A queued/sent review-text request for a finished job. v1 workflow: the
// portal queues it and notifies Alan; Alan sends the actual text himself.
model ReviewRequest {
  id            String       @id @default(cuid())
  clientId      String
  client        Client       @relation(fields: [clientId], references: [id])
  leadId        String?
  lead          ServiceLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerName  String
  phone         String
  jobFinishedAt DateTime
  status        String       @default("QUEUED") // QUEUED | SENT | REMINDED | REVIEWED | DEAD
  sentAt        DateTime?
  remindAt      DateTime?
  createdAt     DateTime     @default(now())
}

// "What I Need From You" — an admin-authored task for the client to act on.
model ClientTask {
  id           String           @id @default(cuid())
  clientId     String
  client       Client           @relation(fields: [clientId], references: [id])
  title        String
  explanation  String
  urgency      String
  responseType String // CHECK | TEXT | PHOTO | BOTH
  status       String           @default("OPEN") // OPEN | DONE
  sortOrder    Int
  completedAt  DateTime?
  submissions  TaskSubmission[]
}

// A client's text/photo answer to a ClientTask. Unlike everything else in
// admin edit mode, THIS autosaves — it's the client's own input, not a
// copy/data edit Alan is publishing. Photos: full resolution kept (they
// feed the Google Business Profile), stored in R2, fileUrl holds the
// object KEY (not a full URL — the public base URL comes from env).
model TaskSubmission {
  id                String     @id @default(cuid())
  taskId            String
  task              ClientTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind              String // TEXT | PHOTO
  textValue         String?
  fileUrl           String?
  submittedByUserId String
  createdAt         DateTime   @default(now())
  notifiedAt        DateTime? // debounces the "first meaningful save" Pushover ping
}

// Alan's during-the-month quick log ("fixed sitemap so Google crawls town
// pages faster") — autofill source for the Monthly Recap builder.
model WorkLog {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  body      String
  source    String   @default("ADMIN_NOTE") // ADMIN_NOTE | SYSTEM
  createdAt DateTime @default(now())
}

// Single source of truth for "what we built this month" — renders on BOTH
// the Overview work block and the Monthly Recap "what we did" list, so the
// two surfaces can never drift apart (handoff §3.7).
model MonthlyWork {
  id              String  @id @default(cuid())
  clientId        String
  client          Client  @relation(fields: [clientId], references: [id])
  month           String
  heroTitleAuto   String? // Claude-generated from the month's data
  heroSubAuto     String?
  heroTitleManual String? // wins over the auto version when set
  heroSubManual   String?
  items           Json // [{ title, detail, recap }]
  noteFromAlan    String?
  nextMonth       Json // string[]

  @@unique([clientId, month])
}

// Every client-facing string on local-services pages, once a client has an
// admin override. Resolution is always `override ?? registry default` — see
// src/content/local-services.ts (Phase 2). Nothing renders as a hardcoded
// string on a local-services page; it goes through this table or it's a
// bug.
model PortalContent {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([clientId, key])
}

// A manual override of a normally-computed ("data tier") number. One row
// per overridden figure; resetting deletes the row so the live resolver
// takes over again on the next render. originalValue captures the live
// value at the moment of the override, for the "live value is X" badge.
model MetricOverride {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  scopeKey      String // e.g. "lsa.cpl:2026-07"
  value         String
  originalValue String
  createdAt     DateTime @default(now())

  @@unique([clientId, scopeKey])
}

// Where a Pushover/email/SMS notification for a client (or a specific
// person on that client, e.g. Bryan vs. Desiree) should go. SMS is a
// stubbed channel type only — not implemented this build (handoff §5/§8).
model NotificationChannel {
  id       String  @id @default(cuid())
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])
  userId   String?
  channel  String // PUSHOVER | EMAIL | SMS
  address  String
  active   Boolean @default(true)
}

// Delivery log for every notification the app has ever tried to send.
model Notification {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  kind        String // NEW_LEAD | TASK_SUBMISSION | WATCHDOG | SYNC_FAILURE | REVIEW_REQUEST
  payload     Json
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?
  error       String?

  @@index([clientId, kind, createdAt])
}
