# Railway Postgres (dedicated instance for this product — see D2)
DATABASE_URL="postgresql://user:password@host:port/database"

# Smartlead
SMARTLEAD_API_KEY=""

# Clerk (magic-link auth, invite-only — see D3)
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_WEBHOOK_SECRET="" # signing secret from Clerk Dashboard > Webhooks endpoint
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"

# Cron guard for /api/cron/sync (Railway cron sends this as a Bearer header)
CRON_SECRET=""

# ---------- LOCAL_SERVICES client type (see IMPLEMENTATION_STATE.md) ----------

# AES-256-GCM key for sealing per-client integration credentials
# (ClientIntegration.credentials — CallRail API keys, Gmail/GSC/Places
# refresh tokens). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# DeepSeek — spam classification for parsed website-form emails (Phase 3).
# Alan's explicit choice over Claude; deepseek-chat (not deepseek-reasoner)
# is the model used — see src/lib/spam-classify.ts.
DEEPSEEK_API_KEY=""

# Pushover — new-lead / watchdog / sync-failure notifications (Phase 3).
# Each NotificationChannel row can carry its OWN app token (Alan's actual
# setup: he and Canencia's shared client channel use two DIFFERENT
# Pushover apps, not one shared one) — this is only a fallback default for
# a channel that doesn't specify its own.
PUSHOVER_APP_TOKEN=""

# Google Cloud OAuth app credentials (one app, shared across every client's
# Gmail/GSC consent — the per-client refresh token itself lives sealed in
# ClientIntegration, not here). No self-serve OAuth UI: Alan completes the
# one-time consent per client via an admin-only route.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="" # must exactly match the Google Cloud OAuth app's registered redirect URI, e.g. https://portal.woodsascension.com/api/admin/integrations/google/callback

# NOTE: CallRail API keys are NOT a global env var — each client's CallRail
# account is stored per-client in ClientIntegration.credentials (sealed with
# ENCRYPTION_KEY), since different local-services clients may have
# different CallRail accounts.
